{
  "name": "arena-audit",
  "version": "2.7.0",
  "description": "Evidence-anchored multi-agent tournament codebase audit engine for any AI harness (Claude Code, Cursor, Windsurf, ZCode, CI/CD)",
  "main": "bin/arena-audit.mjs",
  "bin": {
    "arena-audit": "./bin/arena-audit.mjs"
  },
  "type": "module",
  "scripts": {
    "start": "node bin/arena-audit.mjs",
    "test": "node --test --test-timeout=15000 \"tests/unit/**/*.test.mjs\"",
    "smoke": "node bin/arena-audit.mjs --gates-only",
    "eval": "node src/evals/run-eval.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali39999-hue/arena-audit.git"
  },
  "keywords": [
    "ai-agent",
    "audit",
    "evidence-engine",
    "devsecops",
    "claude-code",
    "zcode",
    "cursor",
    "code-review",
    "tournament",
    "arena",
    "multi-agent",
    "sarif"
  ],
  "author": "ali39999-hue",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6"
  }
}
